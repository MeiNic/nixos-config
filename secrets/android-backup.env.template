# Copy to secrets/android-backup.env, fill in a real password, then:
#   sudo chown root:root /etc/nixos/secrets/android-backup.env
#   sudo chmod 600 /etc/nixos/secrets/android-backup.env
# Loaded at runtime by systemd (EnvironmentFile=) into the
# android-backup-auto / android-backup-manual services - never imported into
# Nix, so it never touches the Nix store. See README.md § Android Backup.
archive_password=change-me-to-a-strong-passphrase
