# secrets/eduroam.nix.template  -  SAFE TO COMMIT (no real values)
# Copy to secrets/eduroam.nix and fill in your real values.
#
# identity
#   The Common Name (CN) of your eduroam client certificate. Read it from
#   your extracted cert with:
#     openssl x509 -in /etc/nixos/certs/eduroam-client.pem -noout -subject
#   and copy the CN= part, e.g. 1234567890@easyroam-pca.your-uni.de
#
# domainSuffixMatch
#   Semicolon-separated suffixes of your home RADIUS server name(s). These
#   are the only servers your certificate will ever be released to. Discover
#   the name(s) your supplicant is shown with (depth=0 line):
#     journalctl -u wpa_supplicant | grep 'PEER-CERT depth=0'
#   then use the parent domain(s). Most easyroam/DFN users need their own
#   institution's domain plus "eduroam.de" (DFN's central roaming server).
{
  identity          = "XXXXXXXXXXXXXXXXXXX@easyroam-pca.your-uni.de";
  domainSuffixMatch = "your-uni.de;eduroam.de";
}
