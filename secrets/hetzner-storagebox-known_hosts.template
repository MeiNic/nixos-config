# Don't fill this in by hand - generate the real file with ssh-keyscan so the
# host key is pinned to what the Storage Box actually presents. One line per
# sub-account host that a service connects to (android-backup.nix and
# backup/borg.nix each use their own sub-account):
#
#   sudo mkdir -p /etc/nixos/secrets
#   ssh-keyscan -p 23 <android-sub-account>.your-storagebox.de | sudo tee /etc/nixos/secrets/hetzner-storagebox-known_hosts
#   sudo chown root:root /etc/nixos/secrets/hetzner-storagebox-known_hosts
#   sudo chmod 600 /etc/nixos/secrets/hetzner-storagebox-known_hosts
#
# For each further sub-account, add its keys to the same file - but only after
# checking they match the ones already pinned (sub-accounts of one box are
# expected to present the same host keys; a mismatch means stop and investigate):
#
#   ssh-keyscan -p 23 <other-sub-account>.your-storagebox.de | sudo tee -a /etc/nixos/secrets/hetzner-storagebox-known_hosts
#
# Verify the printed fingerprint against Hetzner Robot's panel for this
# Storage Box before trusting it. See README.md § Android Backup and
# § Offsite backup.
