# =============================================================================
# Authentication: sudo, fingerprint daemon, YubiKey, PAM policy
# =============================================================================
# The YubiKey FIDO2 LUKS unlock happens in the initrd: system/boot.nix.
{ config, lib, pkgs, ... }:

let
  inherit (import ../settings.nix) user;

  pamLib = "${pkgs.pam}/lib/security";
  fpSo   = "${pkgs.fprintd}/lib/security/pam_fprintd.so";
  kwSo   = "${pkgs.kdePackages.kwallet-pam}/lib/security/pam_kwallet5.so";
  keySo  = "${pamLib}/pam_keyinit.so";

  flockArgs = "deny=2 unlock_time=0";  # 2 failures → locked until `faillock --user nico --reset`

  # ── KDE lock screen authentication (Option A) ──────────────────────────────
  # Plasma 6's locker drives THREE parallel PAM services, and unlocks on the
  # first one that succeeds:
  #   kde             → password        (this stack: password AND fingerprint)
  #   kde-fingerprint → fingerprint     (DENIED below — fp must never unlock alone)
  #   kde-smartcard   → YubiKey PIV     (auto-generated by security.pam.p11 → pam_p11)
  #
  # Effective policy:  YubiKey-PIV  OR  (password THEN fingerprint).
  # Fingerprint is treated as a mandatory 2nd factor, never a standalone key,
  # because the libfprint/Goodix path is not a trustworthy sole factor.
  #
  # faillock counts a wrong password OR a bad swipe. After 2 it locks; the
  # rescue paths while locked are the YubiKey PIV (on the lock screen itself)
  # or a TTY password login (Ctrl+Alt+F2) followed by `faillock --user nico --reset`.
  kdeAuthText = ''
    auth required     ${pamLib}/pam_faillock.so preauth silent ${flockArgs}
    auth [success=1 default=bad] ${pamLib}/pam_unix.so likeauth try_first_pass
    auth [default=die]           ${pamLib}/pam_faillock.so authfail
    auth [success=1 default=bad] ${fpSo} timeout=10
    auth [default=die]           ${pamLib}/pam_faillock.so authfail
    auth optional     ${kwSo}
    auth sufficient   ${pamLib}/pam_faillock.so authsucc
    auth required     ${pamLib}/pam_deny.so

    account required  ${pamLib}/pam_faillock.so
    account required  ${pamLib}/pam_unix.so

    password sufficient ${pamLib}/pam_unix.so nullok yescrypt

    session required  ${pamLib}/pam_unix.so
    session optional  ${kwSo}
  '';

  # Standalone fingerprint method: always deny, so a swipe by itself can never
  # unlock the screen. The reader is only honoured as the 2nd factor in `kde`.
  fpDenyText = ''
    auth     required ${pamLib}/pam_deny.so
    account  required ${pamLib}/pam_unix.so
    password required ${pamLib}/pam_deny.so
    session  required ${pamLib}/pam_unix.so
  '';
in

{
  # ── Sudo ───────────────────────────────────────────────────────────────────
  security.sudo.enable = true;
  security.sudo.execWheelOnly = false;

  # Only nixos-rebuild still needs sudo – keep that NOPASSWD rule.
  security.sudo.extraRules = [
    {
      users    = [ user ];
      commands = [
        {
          command = "/run/current-system/sw/bin/nixos-rebuild *";
          options = [ "NOPASSWD" ];
        }
      ];
    }
  ];

  # ── Fingerprint Sensor ────────────────────────────────────────────────────
  # We deliberately do NOT use `services.fprintd.enable`, because that flips
  # NixOS's per-service `fprintAuth` default to true — adding the fingerprint as
  # a *sole* auth factor to sudo, login, polkit, sshd, etc. Our security model
  # (the PAM policy below) permits the fingerprint only as the mandatory 2nd
  # factor at the KDE lock screen, never on its own. So we provision just the
  # daemon (identical to what `enable` does) and leave the global `fprintAuth`
  # at false.
  systemd.packages       = [ pkgs.fprintd ];
  services.dbus.packages = [ pkgs.fprintd ];
  # fprintd CLI tools (fprintd-enroll/-list/-verify) are added to
  # environment.systemPackages at the bottom.

  # The Goodix MOC sensor gets stuck in fprintd's "suspended" state across a
  # lid-close suspend: the resume signal races with the lock screen grabbing the
  # device, so every identify fails instantly with "Cannot run while suspended"
  # (looks like a spurious read with no finger on the sensor). Forcing fprintd to
  # restart on resume clears the stuck state. try-restart is a no-op when fprintd
  # has already deactivated (it is D-Bus activated), so there is nothing to clear.
  powerManagement.resumeCommands = ''
    ${pkgs.systemd}/bin/systemctl try-restart fprintd.service
  '';

  # ── YubiKey ────────────────────────────────────────────────────────────────
  # Smart-card daemon, needed for PIV.
  services.pcscd.enable = true;

  # FIDO2/U2F stays global: LUKS boot unlock, sudo, and TTY login still use it.
  security.pam.u2f = {
    enable   = true;
    settings = {
      authfile = config.sops.secrets.u2f-mappings.path;
      cue      = true;
    };
  };

  # YubiKey PIV / PKCS#11. Enabling this makes the Plasma module emit the
  # `kde-smartcard` lock-screen method (pam_p11, control "sufficient"), which
  # authenticates against ~/.eid/authorized_certificates via opensc-pkcs11.
  # It also becomes an accepted factor for sudo / login / sddm.
  security.pam.p11.enable = true;

  # ── Lock Screen ────────────────────────────────────────────────────────────
  # Plasma 6 uses the `kde` service (not `kscreenlocker`).
  security.pam.services.kde.text             = lib.mkForce kdeAuthText;
  security.pam.services.kde-fingerprint.text = lib.mkForce fpDenyText;

  # The smartcard (YubiKey PIV) method must be YubiKey-only. Drop the pam_unix
  # that NixOS adds by default, so a password can never slip in via this track.
  security.pam.services.kde-smartcard.unixAuth = lib.mkForce false;

  # ── Kernel Session Keyring ─────────────────────────────────────────────────
  # NixOS never wires up pam_keyinit anywhere, so processes never join a
  # proper kernel session keyring — keyctl calls (e.g. proton-pass-cli's
  # keyutils-backed credential store) see a lazily-created keyring they
  # aren't a possessor of and fail with EACCES on search. `login` covers TTY
  # logins and, via its "session include login", the sddm graphical login
  # too; `systemd-user` covers the per-user systemd instance that actually
  # spawns the desktop session. "force revoke" discards any such stale
  # keyring and joins a fresh one owned by the session.
  security.pam.services.login.rules.session.keyinit = {
    control    = "optional";
    modulePath = keySo;
    args       = [ "force" "revoke" ];
    order      = config.security.pam.services.login.rules.session.env.order - 50;
  };
  security.pam.services.systemd-user.rules.session.keyinit = {
    control    = "optional";
    modulePath = keySo;
    args       = [ "force" "revoke" ];
    order      = config.security.pam.services.systemd-user.rules.session.env.order - 50;
  };

  environment.systemPackages = with pkgs; [
    fprintd          # fingerprint daemon + CLI (enroll/list/verify); see note above
    yubikey-manager
  ];
}
